@model List<ProyectoProgramacionAvanzadaWeb_G4.Models.Horario>


<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="text-center mt-4">
    <h3>Listado de Horarios Disponibles</h3>
</div>
<div class="d-flex justify-content-center mt-4">
    <div class="table-responsive" style="max-width: 700px; width: 100%;">
        <table id="tablas" class="table table-striped table-hover table-bordered">
            <thead class="table-primary text-center">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Observación</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.HoraFecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Observacion</td>
                            <td class="text-center">
                                <form asp-action="EliminarHorario" asp-controller="Horario" method="post" id="EliminarHorarioform" class="d-inline">
                                    <input type="hidden" name="idHorario" value="@item.IdHorario" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/DataTable.js"></script>
