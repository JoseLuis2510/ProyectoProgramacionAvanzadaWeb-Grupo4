@model List<ProyectoProgramacionAvanzadaWeb_G4.Models.Cita>


<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<div class="text-center mt-4">
    <h3>Calendario</h3>
</div>

<div class="d-flex justify-content-center mt-4">
    <div style="max-width: 900px; width: 100%;">
        <div id="calendar"></div>
    </div>
</div>


<div class="modal fade" id="citaModal" tabindex="-1" aria-labelledby="citaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="citaModalLabel">Detalle de la Cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p><strong>Nombre:</strong> <span id="modalNombre"></span></p>
                <p><strong>Descripción:</strong> <span id="modalDescripcion"></span></p>
                <p><strong>Horario:</strong> <span id="modalHorario"></span></p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            events: '/Cita/CalendarioWebAdministrador',
            eventClick: function (info) {
                // Si usas jQuery:
                $('#modalNombre').text(info.event.extendedProps.nombre);
                $('#modalDescripcion').text(info.event.extendedProps.descripcion);
                $('#modalHorario').text(info.event.extendedProps.horarioTexto);

                var citaModal = new bootstrap.Modal(document.getElementById('citaModal'));
                citaModal.show();


            }
        });

        calendar.render();
    });
</script>
