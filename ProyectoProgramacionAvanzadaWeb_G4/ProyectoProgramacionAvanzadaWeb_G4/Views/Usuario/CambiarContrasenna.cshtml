@model Autenticacion
@{
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-center">Actualización de contraseña</h4>
            </div>
            <hr>


            <form class="form-horizontal" asp-controller="Usuario" asp-action="CambiarContrasenna">
                @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
                {
                    <div class="alert alert-info" role="alert">
                        @ViewBag.Mensaje
                    </div>
                }

            <input id="Mensaje" type="hidden" value="@ViewBag.Mensaje">

            <div class="card-body">

                <div class="form-group row">
                    <label for="title1" class="col-sm-3 text-right control-label col-form-label">Contraseña Nueva</label>
                    <div class="col-sm-6">
                        <input type="password" asp-for="Contrasenna" class="form-control">
                    </div>
                </div>

                <div class="form-group row">
                    <label for="com12" class="col-sm-3 text-right control-label col-form-label">Confirmar Contraseña</label>
                    <div class="col-sm-6">
                        <input type="password" asp-for="ConfirmarContrasenna" class="form-control">
                    </div>
                </div>

            </div>
            <hr>
                <div class="card-body text-end">
                <div class="text-right">
                        <button id="btnProcesar" class="btn" type="submit" style="background-color: #6C82FF; color: white;">
                            Actualizar
                        </button>
                </div>
            </div>
        </form>
    </div>
</div>
</div>

<script src="~/lib/jquery.min.js"></script>