@{
    ViewData["Title"] = "Gráfico de Usuarios";
    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;
}

<div style="text-align: center; margin-bottom: 15px;">
    <h2>Total de Usuarios Registrados</h2>
    <div style="display: inline-flex; gap: 15px;">
        <button id="btnPng" style="display: flex; align-items: center; background-color: #007bff; color: white; border: none; border-radius: 5px; padding: 10px 20px; cursor: pointer; transition: background-color 0.3s;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16" style="margin-right: 8px;">
                <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v9.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 11.293V1.5A.5.5 0 0 1 8 1z" />
            </svg>
            Descargar PNG
        </button>

        <button id="btnSvg" style="display: flex; align-items: center; background-color: #28a745; color: white; border: none; border-radius: 5px; padding: 10px 20px; cursor: pointer; transition: background-color 0.3s;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16" style="margin-right: 8px;">
                <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v9.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 11.293V1.5A.5.5 0 0 1 8 1z" />
            </svg>
            Descargar SVG
        </button>
    </div>
</div>

<div id="graficoUsuarios" style="width: 100%; height: 400px;"></div>

<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/exporting.js"></script>

<script>
    const chart = Highcharts.chart('graficoUsuarios', {
        chart: {
            type: 'column'
        },
        title: {
            text: null
        },
        xAxis: {
            categories: ['Usuarios']
        },
        yAxis: {
            min: 0,
            allowDecimals: false,
            title: {
                text: 'Cantidad'
            }
        },
        tooltip: {
            pointFormat: 'Total: <b>{point.y}</b>'
        },
        series: [{
            name: 'Total Usuarios',
            data: [@totalUsuarios],
            color: '#90ed7d'
        }],
        exporting: {
            enabled: false
        },
        credits: {
            enabled: false
        }
    });

    
</script>
<script src="~/js/DescargarGraficos.js"></script>
