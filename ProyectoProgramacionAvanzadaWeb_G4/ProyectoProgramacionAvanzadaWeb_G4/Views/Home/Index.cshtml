<!-- Sección principal (Hero) -->
<div class="text-dark py-5" style="background-color: #ffffff;">
    <div class="container text-center">
        <br>
        <h1 class="display-4 fw-bold">Clinica Dental </h1>
        <p class="lead mt-3">Expertos en salud y estética dental en Costa Rica.</p>
        @{
            var tieneCitaStr = Context.Session.GetString("TieneCita") ?? "false";
            bool tieneCita = bool.TryParse(tieneCitaStr, out var valor) ? valor : false;
        }
         @if (!tieneCita){
            <a asp-controller="Cita" asp-action="CrearCita" class="btn text-white" style="background-color: #638DFF;">Programe su cita</a>
         }
        else{
            <a asp-controller="Cita" asp-action="CitaAgendada" class="btn text-white" style="background-color: #638DFF;">Programe su cita</a>
        }
                           
        
       

        <!-- Galería de imágenes -->
        <div class="row justify-content-center mt-5">
            <div class="col-md-2 mb-3">
                <img src="~/css/images/Clinica1.jpg" alt="Clínica 2" class="img-fluid rounded">
            </div>
            <div class="col-md-2 mb-3">
                <img src="~/css/images/Clinica2.jpg" alt="Clínica 2" class="img-fluid rounded">
            </div>
            <div class="col-md-2 mb-3">
                <img src="~/css/images/Clinica3.jpg" alt="Clínica 3" class="img-fluid rounded">
            </div>
        </div>
    </div>
</div>

<!-- Sección de Servicios -->
<div class="py-5" style="background-color: #ffffff;">
    <div class="container text-center">
        <h2 class="fw-bold mb-5" style="color: #638DFF;">Nuestros servicios</h2>

        <div class="text-start mx-auto" style="max-width: 700px;">
            <div class="mb-4">
                <h4 class="fw-bold" style="color: #638DFF;">Implantes <span class="ms-1"></span></h4>
                <p>Recupere sus dientes perdidos mediante tornillos de titanio de gran durabilidad, que le permitirán sonreír naturalmente por años.</p>
            </div>
            <div class="mb-4">
                <h4 class="fw-bold" style="color: #638DFF;">Estética <span class="ms-1"></span></h4>
                <p>Un conjunto de procedimientos que se realizan para mejorar su sonrisa y aumentarle la confianza y tranquilidad al expresarse.</p>
            </div>
            <div>
                <h4 class="fw-bold" style="color: #638DFF;">Reconstrucción de boca <span class="ms-1"></span></h4>
                <p>Lo acompañamos en la restauración de su boca, en búsqueda de salud, seguridad y comodidad.</p>
            </div>
        </div>
    </div>
</div>

<div class="py-4" style="background-color: #ffffff;">
    <div class="container" style="max-width: 900px;">
        <div class="row align-items-center">
            <!-- Imagen del doctor -->
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="~/css/images/doctor.jpg" alt="Dr. Juan Pérez" class="img-fluid rounded-circle shadow"
                     style="width: 200px; height: 200px; object-fit: cover;">
            </div>

            <!-- Descripción -->
            <div class="col-md-8 text-start">
                <h3 class="fw-bold mb-2" style="color: #638DFF;">Dr. Juan Pérez</h3>
                <h5 class="text-muted mb-3">Odontólogo</h5>
                <p style="font-size: 1.05rem;">
                    El Dr. Juan Pérez cuenta con más de 15 años de experiencia en odontología estética y rehabilitación oral.
                    Su enfoque está centrado en brindar tratamientos personalizados y garantizar la comodidad y confianza de cada paciente.
                    Es reconocido por su calidez humana, precisión clínica y resultados naturales.
                </p>
            </div>
        </div>
    </div>
</div>

